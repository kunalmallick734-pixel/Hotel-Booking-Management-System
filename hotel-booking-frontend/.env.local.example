# Copy to .env.local (gitignored). Must match backend PORT (default 5001; 5000 often taken on macOS).
VITE_API_BASE_URL=http://localhost:5001

# Razorpay Key ID (rzp_test_...) — required for Booking page payment popup.
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# The secret key lives ONLY in backend .env as RAZORPAY_KEY_SECRET
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
